generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

enum PaymentStatus {
  PAID
  CREDIT
}

model Company {
  id                    String     @id @default(cuid())
  name                  String
  // Bolívares (VES) per 1 EUR. Set by the shop owner and updated daily.
  exchangeRate          Decimal?   @db.Decimal(12, 4)
  exchangeRateUpdatedAt DateTime?
  // Small logo image as a base64 data URL, and a hex brand accent color.
  logoDataUrl           String?    @db.Text
  brandColor            String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  users                 User[]
  products              Product[]
  sales                 Sale[]
  customers             Customer[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
}

model Product {
  id                String     @id @default(cuid())
  name              String
  sku               String?
  category          String?
  priceCents        Int
  costCents         Int?
  stock             Int        @default(0)
  lowStockThreshold Int        @default(5)
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  companyId         String
  company           Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  saleItems         SaleItem[]

  @@unique([companyId, sku])
  @@index([companyId, isActive])
  @@index([companyId, category])
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  phone     String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@unique([companyId, phone])
  @@index([companyId])
}

model Sale {
  id                    String         @id @default(cuid())
  createdAt             DateTime       @default(now())
  totalCents            Int
  // Null for CREDIT sales until the customer actually pays (see paymentStatus).
  paymentMethod         PaymentMethod?
  note                  String?
  // Snapshot of Company.exchangeRate (VES per EUR) at the moment this sale was
  // completed, so historical receipts/reports never change if the rate is
  // updated later. Null for sales completed before this feature existed.
  exchangeRate          Decimal?       @db.Decimal(12, 4)
  // Whether the customer paid in physical foreign currency (USD/EUR) rather
  // than bolívares, regardless of paymentMethod.
  paidInForeignCurrency Boolean        @default(false)
  // Snapshot of the customer's data at the time of sale (kept even if the
  // Customer record is later edited or deleted).
  customerFirstName     String?
  customerLastName      String?
  customerPhone         String?
  customerAddress       String?
  customerId            String?
  customer              Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Confirmation/reference number for Pago Móvil transfers, entered manually.
  paymentReference      String?
  // Whether the sale was paid at checkout or sold on credit (to be collected
  // later). paidAt is set when a CREDIT sale is later marked as paid.
  paymentStatus         PaymentStatus  @default(PAID)
  paidAt                DateTime?
  // Exchange rate in effect on the day a CREDIT sale was actually collected
  // (vs. exchangeRate, the rate when the sale/credit was originally granted).
  // Only set when payment is registered for a credit sale.
  paidExchangeRate      Decimal?       @db.Decimal(12, 4)
  // Sequential per-company number for the "Nota de entrega" document.
  controlNumber         Int?
  // Voided sales are excluded from revenue/report totals but stay visible in
  // history for auditing. Stock is restored when a sale is voided or deleted.
  voided                Boolean        @default(false)
  voidedAt              DateTime?
  companyId             String
  company               Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items                 SaleItem[]

  @@unique([companyId, controlNumber])
  @@index([companyId, createdAt])
}

model SaleItem {
  id             String   @id @default(cuid())
  saleId         String
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String
  unitPriceCents Int
  quantity       Int
  subtotalCents  Int

  @@index([saleId])
  @@index([productId])
}
