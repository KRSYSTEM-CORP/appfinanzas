generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
  ZELLE
  BINANCE
  PAYPAL
  // Physical card terminal ("punto de venta") — distinct from CARD/Pago
  // Móvil above, which is the instant phone-number bank transfer.
  POS
  // Bank wire transfer, as opposed to Pago Móvil's instant phone transfer.
  TRANSFER
}

// Canal por el que entró la venta.
enum SaleChannel {
  MOSTRADOR
  DELIVERY
  PICKUP
  ONLINE
}

enum PaymentStatus {
  PAID
  CREDIT
}

enum UserStatus {
  // Awaiting approval from a KYRA System platform admin after signup.
  PENDING
  ACTIVE
  // Approval denied, or access later revoked by a platform admin.
  SUSPENDED
}

// Plan de suscripción de la empresa (ver lib/plans.ts). Las empresas que ya
// existían antes de los planes quedan en CORPORATIVO para no perder nada.
enum PlanTier {
  EMPRENDE
  PYME
  CORPORATIVO
}

enum PaymentReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BinancePayOrderStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum PagoMovilOrderStatus {
  PENDING
  PAID
  EXPIRED
}

// The currency that Product.priceCents/Sale.totalCents/etc. are canonically
// denominated in. Same stored cents value either way — this app has always
// treated USD and EUR as 1:1 equivalent (no real forex tracked between them),
// so switching a company's reference currency is purely a display/label
// choice, not a data conversion.
enum ReferenceCurrency {
  EUR
  USD
}

// GERENTE has full access; VENDEDOR has access to everything except
// Finanzas and Administración de perfiles (see requireManager() in
// lib/session.ts).
enum Role {
  GERENTE
  VENDEDOR
}

// Paper size used to lay out the browser print view (window.print()) for
// delivery notes, quotes and payment receipts — separate from the jsPDF
// downloads, which are always Letter-sized. THERMAL_* sizes render a
// single-column stacked layout; LETTER/A4 render a table like the PDF.
enum PrintPaperSize {
  THERMAL_58
  THERMAL_80
  LETTER
  A4
}

// Venezuelan IVA (VAT) treatment of a product/line item. GENERAL and REDUCED
// use Company.ivaGeneralRatePercent/ivaReducedRatePercent (configurable,
// since these rates change by law over time); EXEMPT is always 0% (many
// food staples, medicines, books). See lib/tax.ts — prices are always
// tax-INCLUSIVE in this app (matching Venezuelan retail sticker-price
// convention), so this category only decomposes an already-fixed total into
// base imponible + IVA for reporting; it never changes what the customer
// pays.
enum TaxCategory {
  GENERAL
  REDUCED
  EXEMPT
}

// Whether a Purchase's bill has been settled with the supplier yet — the
// simplest possible cuentas por pagar (accounts payable) tracking, mirroring
// Sale.paymentStatus's PAID/CREDIT split.
enum PurchasePaymentStatus {
  PAID
  PENDING
}

// Follow-up state for a Quote — PENDING means still awaiting the customer's
// decision, CONVERTED means they came back and bought (as a separate Sale),
// LOST means they decided not to buy. Manually set, not derived.
enum QuoteStatus {
  PENDING
  CONVERTED
  LOST
}

model Company {
  id                    String            @id @default(cuid())
  roles                 CompanyRole[]
  promotions            Promotion[]
  name                  String
  // Short code (derived from id, see signup()) employees use, together with
  // their name and password, to log in without needing an email address.
  loginCode             String            @unique
  // Whether this company uses the dual-currency conversion feature at all.
  // When false, every price/payment is shown/collected in a single
  // referenceCurrency below — no local-currency conversion, no exchange-rate
  // requirement anywhere (POS, reports, PDFs all collapse to one currency).
  exchangeRateEnabled   Boolean           @default(true)
  // See ReferenceCurrency above. Defaults to EUR to preserve the meaning of
  // every company's already-stored prices from before this field existed.
  // USD by default (audit KRPOS-FIS-002): payments in dollars (Zelle, Binance,
  // divisas) are counted 1:1 against the reference currency, which is only
  // exact when the reference is USD.
  referenceCurrency     ReferenceCurrency @default(USD)
  // IGTF agent (see lib/igtf.ts): when true, payments in foreign currency
  // carry igtfRatePercent on top of the sale total.
  isIgtfAgent           Boolean           @default(false)
  igtfRatePercent       Int               @default(3)
  // Local currency per 1 referenceCurrency unit. Set by the shop owner and
  // updated daily. Only meaningful when exchangeRateEnabled is true.
  exchangeRate          Decimal?          @db.Decimal(12, 4)
  exchangeRateUpdatedAt DateTime?
  // ISO 4217 code of the currency this company sells in locally (see
  // lib/currencies.ts for the supported list) — drives all retail-facing
  // formatting (POS, inventory, reports, PDFs). Defaults to VES since every
  // company predating this feature was Venezuelan. Only meaningful when
  // exchangeRateEnabled is true.
  localCurrencyCode     String            @default("VES")
  // Small logo image as a base64 data URL, a hex brand accent color (buttons,
  // icons, links), and a hex background color — all optional; when unset the
  // app falls back to its default light/blue theme. Applied app-wide for the
  // company's own users (owners and employees alike) and on the login screen
  // itself once the company is identified (by email or company code), before
  // the user has actually authenticated.
  logoDataUrl           String?           @db.Text
  brandColor            String?
  brandBackground       String?
  // Fiscal/legal data for delivery notes, quotes and payment receipts. Optional
  // — printed only when the company has filled them in from Settings.
  fiscalLegalName       String?
  fiscalRif             String?
  fiscalAddress         String?           @db.Text
  fiscalPhone           String?
  // Contacto del negocio (Ajustes · Negocio).
  businessCountry       String?
  // Si está activo, no se puede vender como «Cliente general»: cada venta pide nombre y teléfono.
  requireCustomerOnSale Boolean           @default(false)
  businessWhatsapp      String?
  businessInstagram     String?
  // Default paper size for the "Imprimir" browser print view. Editable
  // per-print from the print dialog itself; this is just the preselected
  // default.
  printPaperSize        PrintPaperSize    @default(LETTER)
  // Venezuelan IVA rates, configurable since they change by law over time
  // (e.g. the general rate has moved between 12%/15%/16% historically) —
  // see TaxCategory/lib/tax.ts. Defaults match the rate in effect when this
  // feature was added.
  // Interruptor «Usar IVA»: apagado = no se calcula ni se desglosa IVA (alícuotas efectivas 0).
  ivaEnabled            Boolean           @default(true)
  ivaGeneralRatePercent Int               @default(16)
  ivaReducedRatePercent Int               @default(8)
  // "Contribuyente especial" status — SENIAT designates certain companies as
  // agentes de retención, requiring them to withhold a percentage of IVA on
  // supplier purchases and remit it directly instead of paying the supplier
  // in full (see Purchase.ivaRetainedCents). Most SMBs are NOT designated
  // special taxpayers, hence defaulting to false.
  isIvaWithholdingAgent Boolean           @default(false)
  ivaWithholdingPercent Int               @default(75)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  users                 User[]
  products              Product[]
  sales                 Sale[]
  creditNotes           CreditNote[]
  debitNotes            DebitNote[]
  customers             Customer[]
  quotes                Quote[]
  suppliers             Supplier[]
  purchases             Purchase[]
  stockMovements        StockMovement[]
  // Maintenance billing, managed by a KYRA System platform admin from /admin.
  // Activation itself is charged outside the app for now — only the recurring
  // maintenance cycle is tracked here and can block access. Priced in USD —
  // KYRA System's own billing currency, independent of each company's local
  // retail currency above. The USD/Bs rate used to preview what's owed in
  // bolívares (for VES companies paying via Pago Móvil) is platform-wide
  // (see PlatformSettings), not per company.
  isExempt              Boolean           @default(false)
  // Meta de ganancia neta mensual (divisa referencial), editable desde Finanzas.
  profitGoalCents       Int?
  // Deducciones de nómina en % sobre el sueldo base (editables en Nómina).
  payrollIvssPct        Float             @default(4)
  payrollParoPct        Float             @default(0.5)
  payrollFaovPct        Float             @default(1)
  // Asistente IA: créditos comprados/otorgados (no vencen), consumo del mes y tope diario de consultas.
  aiCreditsExtra        Int               @default(0)
  aiCreditsUsed         Int               @default(0)
  aiPeriod              String?
  aiAskDay              String?
  aiAskCount            Int               @default(0)
  plan                  PlanTier          @default(CORPORATIVO)
  // false hasta que el dueño elige su plan al crear la cuenta (pantalla /choose-plan).
  planChosen            Boolean           @default(true)
  // Reporte semanal por correo a los gerentes (domingo por la noche); opt-in.
  weeklyReportEnabled   Boolean           @default(false)
  // Destinatarios (hasta 5) del reporte diario de ventas por correo.
  dailyReportEmails     String[]          @default([])
  monthlyFeeUsdCents    Int?
  nextPaymentDueDate    DateTime?
  payments              Payment[]
  paymentReports        PaymentReport[]
  binancePayOrders      BinancePayOrder[]
  pagoMovilOrders       PagoMovilOrder[]
  expenses              Expense[]
  cashClosings          CashClosing[]
  cashOpenings          CashOpening[]
  branchTransfers       BranchTransfer[]
  assistantEntries      AssistantEntry[]
  aiCreditRequests      AiCreditRequest[]
  paymentAccounts       PaymentAccount[]
  payrollEmployees      PayrollEmployee[]
  payrollPayments       PayrollPayment[]
  cashOutflows          CashOutflow[]
  branches              Branch[]
  // Custom, per-company sections/improvements a platform admin switches on
  // from /admin for ONE company only (see lib/features.ts) — every other
  // company keeps the app exactly as designed. Holds ids from that registry;
  // empty means the company has no custom features.
  enabledFeatures       String[]          @default([])
}

// A physical location/sucursal of a company — each one has its OWN
// independent product catalog and its own cash register (sales, quotes,
// cierre de caja); nothing is shared between branches except the customer
// list, which stays company-wide (see Customer, unchanged). Every existing
// company got exactly one auto-created "Sucursal Principal" when this model
// was introduced (see the add_branches migration), so nothing already in
// production lost access to its own data.
model Branch {
  id                   String   @id @default(cuid())
  companyId            String
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                 String
  isActive             Boolean  @default(true)
  // Meta de ventas del mes de esta sede (se ve en Sucursales); null = sin meta.
  monthlyGoalCents     Int?
  // Clave de 4 dígitos para entrar a la sede (hash); null = se pide la clave de la cuenta.
  accessKeyHash        String?
  createdAt            DateTime @default(now())
  // Last document number handed out per sequence (see lib/document-sequence.ts).
  // Never derived from count(*): a deleted document must not free its number.
  nextSaleNumber       Int      @default(0)
  nextReceiptNumber    Int      @default(0)
  nextInvoiceNumber    Int      @default(0)
  nextQuoteNumber      Int      @default(0)
  nextPurchaseNumber   Int      @default(0)
  nextCreditNoteNumber Int      @default(0)
  nextDebitNoteNumber  Int      @default(0)

  products       Product[]
  sales          Sale[]
  quotes         Quote[]
  cashClosings   CashClosing[]
  cashOpenings   CashOpening[]
  transfersOut   BranchTransfer[] @relation("TransferFrom")
  transfersIn    BranchTransfer[] @relation("TransferTo")
  cashOutflows   CashOutflow[]
  creditNotes    CreditNote[]
  debitNotes     DebitNote[]
  users          User[]
  purchases      Purchase[]
  stockMovements StockMovement[]

  @@unique([companyId, name])
  @@index([companyId])
}

// Rol de una empresa con permisos editables. baseRole decide si la persona entra como
// gerente (acceso de administración) o como vendedor (acceso por permisos).
model CompanyRole {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  baseRole    Role     @default(VENDEDOR)
  permissions String[] @default([])
  // Minutos sin actividad antes de bloquear la pantalla (5, 10 o 15). Null = valor por defecto del rol.
  lockMinutes Int?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  users       User[]

  @@unique([companyId, name])
  @@index([companyId])
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  // Null for an account that only ever signed up/logged in with Google (see
  // app/api/auth/google/callback) — nothing to verify a password against.
  passwordHash        String?
  // PIN de 4 a 6 números para desbloquear la pantalla (lib/pin.ts). pinHash es el
  // hash con sal para verificarlo; pinKey es un HMAC (con AUTH_SECRET) solo para
  // garantizar que dos personas de la misma empresa no tengan el mismo PIN.
  pinHash             String?
  pinKey              String?
  // Bumped when the password changes; session cookies carry the value they
  // were issued with (SessionPayload.tv), so older cookies stop working on
  // every device (audit KRPOS-SEC-006).
  tokenVersion        Int                  @default(0)
  // Google's stable per-account id ("sub" claim) — set the first time this
  // person uses "Continuar con Google", whether that creates a brand-new
  // company or links onto an existing email/password account.
  googleId            String?              @unique
  companyId           String
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Which branch this employee is fixed to — null for GERENTE/the owner
  // account (they can access/switch between every branch, see
  // switchBranch() in lib/actions/branches.ts), set for every VENDEDOR at
  // creation time (see createEmployee, lib/actions/employees.ts).
  branchId            String?
  branch              Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  // Existing accounts default to ACTIVE so this migration never locks out a
  // user who could already log in; only new signups start at PENDING.
  status              UserStatus           @default(ACTIVE)
  // Platform-wide admin (KYRA System itself), not scoped to a company —
  // can see and manage every tenant's users from /admin.
  isSuperAdmin        Boolean              @default(false)
  // Null for the original owner account created via signup() (which still
  // logs in with email). Set for employee profiles created from
  // /employees. The display name is separate from the employee login handle.
  firstName           String?
  lastName            String?
  // Optional unique login handle for employees. Existing accounts can keep
  // their name-based sign-in until a manager assigns a username.
  loginUsername       String?
  // Small JPEG data URL (resized client-side to 256px), same storage pattern as
  // Company.logoDataUrl / Product.imageDataUrl. Shown on the profiles screen.
  photoDataUrl        String?              @db.Text
  // Existing rows default to GERENTE so every pre-existing owner account
  // keeps its current full access after this migration.
  role                Role                 @default(GERENTE)
  // Optional commission rate this seller earns on their own sales — set from
  // Contabilidad → Ventas por vendedor, purely informational/for payroll
  // (doesn't affect pricing or Sale totals). Null means no commission
  // configured yet.
  commissionPercent   Decimal?             @db.Decimal(5, 2)
  // Which top-level sections this VENDEDOR can access (see lib/sections.ts
  // for the fixed list of togglable ids) — irrelevant for GERENTE, who
  // always sees everything. An empty array means "no restriction configured
  // yet," not "no access" — see requireSectionAccess in lib/session.ts —
  // so activating this feature never locks out an existing seller until a
  // manager explicitly restricts them.
  allowedSections     String[]             @default([])
  // Rol con permisos editables (Ajustes → Equipo y Seguridad). Null = comportamiento anterior
  // (GERENTE = todo; VENDEDOR = allowedSections).
  roleId              String?
  customRole          CompanyRole?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  // Whether this user has clicked through (or skipped) the first-time
  // product tour shown right after login — see components/onboarding/
  // ProductTour.tsx. Existing accounts default to true so nobody who
  // already knows the app suddenly gets the tour forced on them; only
  // brand-new signups/employees start false.
  hasSeenTour         Boolean              @default(true)
  // When this account accepted the Términos y Condiciones / Política de
  // Privacidad — set once, at signup (see confirmSignupCode in
  // lib/actions/auth.ts), for both the email/password and Google paths.
  // Null for every account created before this field existed; never
  // backfilled or gated on for them, only recorded going forward.
  termsAcceptedAt     DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sales               Sale[]               @relation("SaleSeller")
  quotes              Quote[]              @relation("QuoteSeller")
  expenses            Expense[]
  passwordResetTokens PasswordResetToken[]

  @@unique([companyId, loginUsername])
  @@unique([companyId, pinKey])
  @@index([companyId])
  @@index([branchId])
}

// Single-use, short-lived tokens for the "forgot password" flow. Only the
// sha256 hash of the raw token is stored — like a password itself, the raw
// value only ever exists in the emailed link and the requester's browser, so
// a database leak alone can't be used to reset anyone's password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Holds a pending email/password signup between "sent the code" and
// "confirmed it" — the account itself (Company/Branch/User) is only created
// once the code checks out, so there's no half-created company sitting
// around for an abandoned or fake signup. payload is the JSON-encoded
// SignupPayload (see lib/actions/auth.ts) needed to finish provisioning.
model SignupVerification {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  payload   String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// A single failed/attempted hit against a rate-limited auth action (login,
// employee login, password-reset request) — see lib/rate-limit.ts. `key`
// combines a scope prefix with the identifier being limited (email, or
// company code + name for the no-email employee login) so the same table
// serves every limited action without colliding. Not tenant-scoped (this
// tracks abuse attempts against the login surface itself, before any
// company context exists) — same reasoning as User/Company being outside
// Row-Level Security. Old rows are harmless clutter, not a correctness
// issue, since every read here is windowed by createdAt; a periodic cleanup
// isn't required for this to work correctly.
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Product {
  id                  String          @id @default(cuid())
  name                String
  sku                 String?
  category            String?
  // "Al detal" price — the base/default price, unchanged by this field's
  // introduction. Used whenever priceTiersEnabled is off, and as the
  // fallback tier below wholesaleMinQty when it's on.
  priceCents          Int
  costCents           Int?
  stock               Int             @default(0)
  lowStockThreshold   Int             @default(5)
  // Off by default so every existing product keeps requiring/tracking a real
  // stock count exactly as before. When off, stock/lowStockThreshold are
  // ignored everywhere (checkout, ProductPicker, isActive-on-zero-stock) —
  // see resolveTierPrice's sibling in lib/pricing.ts for the analogous
  // "off means ignore" pattern used by priceTiersEnabled below.
  trackStock          Boolean         @default(true)
  isActive            Boolean         @default(true)
  imageDataUrl        String?
  // Quantity-based pricing (detal/mayor/gran mayor) — off by default. Each
  // tier only applies once BOTH its price and its minimum quantity are set;
  // a business can configure just "mayor" without "gran mayor". See
  // resolveTierPrice in lib/pricing.ts for the exact resolution rule.
  priceTiersEnabled   Boolean         @default(false)
  wholesalePriceCents Int?
  wholesaleMinQty     Int?
  bulkPriceCents      Int?
  bulkMinQty          Int?
  // IVA treatment for this product — see TaxCategory. Defaults to GENERAL
  // (the standard rate) so every product created before this feature existed
  // is treated the same way checkout already implicitly assumed.
  taxCategory         TaxCategory     @default(GENERAL)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  companyId           String
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Each branch has its own independent catalog — a product belongs to
  // exactly one branch, not shared/counted across the company's other
  // branches (see the plan doc for why: confirmed with the user).
  branchId            String
  branch              Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  saleItems           SaleItem[]
  quoteItems          QuoteItem[]
  purchaseItems       PurchaseItem[]
  stockMovements      StockMovement[]

  @@unique([branchId, sku])
  @@index([companyId, isActive])
  @@index([branchId, isActive])
  @@index([companyId, category])
}

// Auditable record of each inventory adjustment. Snapshots remain readable
// if the product or employee is later removed.
model StockMovement {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String
  actorId        String?
  actorName      String
  reason         String
  sourceType     String?
  sourceId       String?
  quantityChange Int
  stockBefore    Int
  stockAfter     Int
  createdAt      DateTime @default(now())

  @@index([companyId, branchId, createdAt])
  @@index([productId, createdAt])
}

model Customer {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  phone           String
  address         String?
  // Cédula/RIF — optional, needed on the Libro de Ventas SENIAT report for
  // any customer who wants a proper fiscal invoice ("Consumidor Final"
  // customers without one are still valid, just reported without a RIF).
  rif             String?
  // Free-text notes a seller/manager jots down about this customer
  // (preferences, agreements, context for the next call) — shown on the
  // ficha de cliente, not on any customer-facing document.
  notes           String?   @db.Text
  // Optional reminder date — surfaced as "clientes a contactar" on the
  // customers list once this date arrives (see listCustomersToContact).
  nextContactDate DateTime? @db.Date
  // Fecha de nacimiento (solo día y mes importan; el año es opcional en la práctica).
  birthDate       DateTime? @db.Date
  // Correo del cliente (opcional, se pide al registrarlo en el POS).
  email           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sales           Sale[]

  @@unique([companyId, phone])
  @@index([companyId])
  @@index([companyId, nextContactDate])
}

model Sale {
  id                    String         @id @default(cuid())
  createdAt             DateTime       @default(now())
  totalCents            Int
  // IVA breakdown of totalCents, aggregated from each SaleItem's own
  // baseCents/taxCents (see lib/tax.ts) — purely a decomposition of the
  // already-fixed tax-inclusive total for the Libro de Ventas report and a
  // properly-broken-down Factura; baseImponibleCents + taxCents always
  // equals totalCents. Default 0 for every sale completed before this
  // feature existed (their true breakdown was never tracked).
  baseImponibleCents    Int            @default(0)
  taxCents              Int            @default(0)
  // Total discount actually applied (sum of every SaleItem's own
  // discountCents) — already subtracted out of totalCents/baseImponibleCents/
  // taxCents above; kept here only so receipts/facturas can print an
  // explicit "Descuento" line instead of the discount silently disappearing
  // into a lower total. 0 for every sale completed before this feature
  // existed.
  discountCents         Int            @default(0)
  // Null for CREDIT sales until the customer actually pays (see paymentStatus).
  paymentMethod         PaymentMethod?
  note                  String?
  // Snapshot of Company.exchangeRate (VES per EUR) at the moment this sale was
  // completed, so historical receipts/reports never change if the rate is
  // updated later. Null for sales completed before this feature existed.
  exchangeRate          Decimal?       @db.Decimal(12, 4)
  // Whether the customer paid in physical foreign currency (USD/EUR) rather
  // than bolívares, regardless of paymentMethod.
  paidInForeignCurrency Boolean        @default(false)
  // Snapshot of the customer's data at the time of sale (kept even if the
  // Customer record is later edited or deleted).
  customerFirstName     String?
  customerLastName      String?
  customerPhone         String?
  customerAddress       String?
  // Snapshot of Customer.rif at sale time, same reasoning as the other
  // customerXxx snapshot fields above — needed on the Libro de Ventas report
  // regardless of whether the Customer record is later edited.
  customerRif           String?
  customerId            String?
  customer              Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Confirmation/reference number for Pago Móvil transfers, entered manually.
  paymentReference      String?
  // Whether the sale was paid at checkout or sold on credit (to be collected
  // later). paidAt is set when a CREDIT sale is later marked as paid.
  paymentStatus         PaymentStatus  @default(PAID)
  channel               SaleChannel    @default(MOSTRADOR)
  paidAt                DateTime?
  // Exchange rate in effect on the day a CREDIT sale was actually collected
  // (vs. exchangeRate, the rate when the sale/credit was originally granted).
  // Only set when payment is registered for a credit sale.
  paidExchangeRate      Decimal?       @db.Decimal(12, 4)
  // Sequential per-company number for the "Nota de entrega" document.
  // IGTF collected on the foreign-currency payments (lib/igtf.ts), on top of
  // totalCents. 0 when the company isn't an IGTF agent.
  igtfCents             Int            @default(0)
  controlNumber         Int?
  // Sequential per-company number for the "Recibo de pago" document —
  // independent of controlNumber above. Only assigned the moment a CREDIT
  // sale's debt is actually collected (see registerPayment); a sale that's
  // paid up front at checkout never gets one, since no Recibo de Pago is
  // ever generated for it.
  receiptControlNumber  Int?
  // Sequential per-company number for the "Factura" document — a selectable
  // alternative to "Nota de entrega" for the same sale (same layout, just a
  // different title/numbering), assigned lazily the first time someone
  // actually requests a Factura for this sale (see getOrCreateInvoiceNumber
  // in lib/actions/sales.ts). This is a placeholder ahead of real SENIAT
  // fiscal-machine/homologación integration, deliberately deferred — it does
  // NOT make this a fiscally-compliant invoice yet.
  invoiceNumber         Int?
  // Voided sales are excluded from revenue/report totals but stay visible in
  // history for auditing. Stock is restored when a sale is voided or deleted.
  voided                Boolean        @default(false)
  voidedAt              DateTime?
  companyId             String
  company               Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // Which branch's register this sale happened at — each branch numbers its
  // own controlNumber/receiptControlNumber/invoiceNumber sequence, same as a
  // physically separate cash register would.
  branchId              String
  branch                Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items                 SaleItem[]
  creditNote            CreditNote?
  debitNotes            DebitNote[]
  // Breakdown when the customer split payment across multiple methods (e.g.
  // half cash USD, half Pago Móvil in Bs). The singular paymentMethod/
  // paymentReference/paidInForeignCurrency fields above still mirror the
  // first entry for any code that only needs a quick summary.
  payments              SalePayment[]
  // The employee who made this sale. sellerName is a snapshot (same pattern
  // as customerFirstName/etc above) so it survives the employee being
  // renamed or deleted later; sellerId is nulled in that case but the name
  // printed on past documents never changes.
  sellerId              String?
  seller                User?          @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  sellerName            String?
  // Set when this sale was created via the "Facturar" flow from an existing
  // Quote (see completeSale, lib/actions/sales.ts) rather than typed up from
  // scratch in the POS — @unique so a single quote can never be linked to
  // more than one sale. Null for the vast majority of sales, which were
  // never quoted first.
  quoteId               String?        @unique
  quote                 Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  // Client-generated key for retry-safe offline sale synchronization. Null
  // for online sales; unique per company so a lost response cannot create a
  // second sale when the same queued sale is submitted again.
  idempotencyKey        String?

  @@unique([companyId, idempotencyKey])
  @@unique([branchId, controlNumber])
  @@unique([branchId, receiptControlNumber])
  @@unique([branchId, invoiceNumber])
  @@index([companyId, createdAt])
  @@index([branchId, createdAt])
}

// One entry in a sale's payment breakdown. amountEurCents entries for a sale
// sum to that sale's totalCents (or, for a CREDIT sale being collected, to
// the amount being collected).
model SalePayment {
  id                    String        @id @default(cuid())
  saleId                String
  sale                  Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod         PaymentMethod
  amountEurCents        Int
  // The currency this specific line was actually collected in — "USD" for
  // Zelle/Binance/PayPal, or the company's own localCurrencyCode for
  // Cash/Card/Other (unless marked as foreign cash, then also "USD").
  // amountEurCents above is this converted to the EUR reference used for
  // Sale.totalCents/reconciliation; amountCurrencyCents below is the raw,
  // as-entered amount in currencyCode's own cents. Both null for rows
  // created before per-line currency tracking existed.
  currencyCode          String?
  amountCurrencyCents   Int?
  paidInForeignCurrency Boolean       @default(false)
  reference             String?
  // Snapshot of Company.exchangeRate on the day THIS specific line was
  // recorded — for a credit sale collected via one or more later abonos,
  // each installment can fall on a different day with a different rate,
  // unlike Sale.exchangeRate/paidExchangeRate which only capture the
  // original-sale and final-settlement moments. Null for rows created
  // before this snapshot existed.
  exchangeRate          Decimal?      @db.Decimal(12, 4)
  createdAt             DateTime      @default(now())

  @@index([saleId])
}

model SaleItem {
  id             String      @id @default(cuid())
  saleId         String
  sale           Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String
  // Snapshotted at sale time, same reasoning as productName above — a
  // product's category can change (or the product can be deleted) after the
  // sale, but the document must keep showing what was actually sold. Needed
  // to tell apart two products that share a name but differ by category.
  category       String?
  unitPriceCents Int
  quantity       Int
  // Tax-inclusive subtotal AFTER discount (unitPriceCents * quantity -
  // discountCents) — see discountCents below for the pre-discount figure.
  subtotalCents  Int
  // How much of this line's original (unitPriceCents * quantity) amount was
  // knocked off by the sale's discount — 0 for a non-discounted sale. Kept
  // per item (not just once on Sale) so a printed factura can show each
  // line's own discounted subtotal next to its original price.
  discountCents  Int         @default(0)
  // IVA breakdown snapshot (see lib/tax.ts) — taxCategory/taxRatePercent
  // capture the product's tax treatment AT SALE TIME (a product's category
  // or the company's rate can change later without altering past documents),
  // and baseCents/taxCents decompose subtotalCents (the discounted,
  // tax-inclusive amount) into base imponible + IVA. baseCents + taxCents
  // always equals subtotalCents. Default GENERAL/16/subtotal/0 for rows
  // created before this feature existed — an approximation, not a real
  // historical record, since the true rate/category in effect back then
  // isn't known.
  taxCategory    TaxCategory @default(GENERAL)
  taxRatePercent Int         @default(16)
  baseCents      Int         @default(0)
  taxCents       Int         @default(0)

  @@index([saleId])
  @@index([productId])
}

// Budgets/quotes: same customer+product flow as a Sale, but never decrements
// stock or takes a payment — just produces a "PRESUPUESTO" PDF with its own
// control-number sequence, separate from Sale.controlNumber.
model Quote {
  id                String      @id @default(cuid())
  createdAt         DateTime    @default(now())
  controlNumber     Int?
  totalCents        Int
  exchangeRate      Decimal?    @db.Decimal(12, 4)
  // Which currency this specific quote was issued in — chosen by the seller
  // at generation time, independent of the company's own display defaults.
  // Only meaningful when the company has exchangeRateEnabled; otherwise the
  // quote is always in the reference currency regardless of this flag.
  useLocalCurrency  Boolean     @default(true)
  customerFirstName String?
  customerLastName  String?
  customerPhone     String?
  customerAddress   String?
  companyId         String
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId          String
  branch            Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items             QuoteItem[]
  sellerId          String?
  seller            User?       @relation("QuoteSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  sellerName        String?
  // Free-text, optional — printed on the generated PDF/print view when set.
  note              String?
  // Set automatically by completeSale() the moment this quote is invoiced
  // via the "Facturar" flow (see app/pos/page.tsx's ?fromQuote= prefill) —
  // status flips to CONVERTED in the same transaction. Still settable by
  // hand for a quote that was invoiced some other way, in which case `sale`
  // stays null; the presence of `sale` is what "seguimiento de presupuestos"
  // uses to link straight to the resulting document.
  status            QuoteStatus @default(PENDING)
  // Seguimiento: cuándo se marcó como enviado / visto por el cliente y por qué se perdió.
  sentAt            DateTime?
  viewedAt          DateTime?
  lostReason        String?
  // Vigencia («válido hasta») y recordatorio de seguimiento; historial de seguimiento.
  validUntil        DateTime?
  remindAt          DateTime?
  followUps         QuoteFollowUp[]
  // Virtual back-relation — no column here, see Sale.quoteId (the actual FK,
  // unique so a quote can never be linked to more than one sale).
  sale              Sale?

  @@unique([branchId, controlNumber])
  @@index([companyId, createdAt])
  @@index([branchId, createdAt])
}

// Seguimiento de un presupuesto: llamadas, mensajes por WhatsApp y notas.
model QuoteFollowUp {
  id          String   @id @default(cuid())
  companyId   String
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  kind        String
  text        String?
  createdById String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([quoteId, createdAt])
  @@index([companyId])
}

model QuoteItem {
  id             String   @id @default(cuid())
  quoteId        String
  quote          Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String
  // Snapshotted at quote time — same reasoning as SaleItem.category.
  category       String?
  unitPriceCents Int
  quantity       Int
  subtotalCents  Int

  @@index([quoteId])
  @@index([productId])
}

// A vendor the company buys from — company-wide (not branch-scoped), same
// reasoning as Customer: a supplier can sell to any of the company's
// branches.
model Supplier {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  rif       String?
  phone     String?
  address   String?
  email     String?
  isActive  Boolean    @default(true)
  // Calificación del proveedor de 1 a 5 (opcional).
  rating    Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]

  @@index([companyId])
  @@index([companyId, isActive])
}

// A recorded purchase from a supplier — the inverse of Sale: receiving one
// increases Product.stock (and updates Product.costCents) instead of
// decrementing it, and its paymentStatus tracks cuentas por pagar (money the
// company owes the supplier) instead of money collected from a customer.
// Branch-scoped like Sale/Product, since it affects one branch's own stock
// and its own controlNumber sequence.
model Purchase {
  id                 String                @id @default(cuid())
  companyId          String
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branchId           String
  branch             Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  // Null when this purchase used a manual, one-off supplier name instead of
  // a real Supplier record (see manualSupplierName) — exactly one of the two
  // is ever set, enforced by PurchaseSchema, not the database.
  supplierId         String?
  supplier           Supplier?             @relation(fields: [supplierId], references: [id])
  // Free-text supplier name entered just for this purchase, when the buyer
  // doesn't want a real Supplier record created (see createPurchase) —
  // never turned into one automatically, so it never shows up in the
  // supplier picker or supplier reports.
  manualSupplierName String?
  // Sequential per-branch number KYRA assigns to this purchase — independent
  // of the supplier's own invoice numbering below.
  controlNumber      Int?
  // The supplier's own invoice/control number, free text (unlike Sale's
  // controlNumber, this isn't KYRA's to assign).
  supplierInvoiceNo  String?
  createdAt          DateTime              @default(now())
  totalCents         Int
  // IVA breakdown, same reasoning as Sale.baseImponibleCents/taxCents.
  baseImponibleCents Int                   @default(0)
  taxCents           Int                   @default(0)
  // IVA withheld from the supplier when the company is a designated
  // "agente de retención" (see Company.isIvaWithholdingAgent) — this amount
  // is remitted to SENIAT directly instead of paid to the supplier, so the
  // supplier is actually owed (totalCents - ivaRetainedCents), not
  // totalCents, once paymentStatus flips to PAID.
  ivaRetainedCents   Int                   @default(0)
  paymentStatus      PurchasePaymentStatus @default(PENDING)
  paidAt             DateTime?
  note               String?
  // Voided purchases are excluded from cost/stock reports but stay visible
  // for auditing; stock is reversed (decremented back out) same as a voided
  // Sale restores it.
  voided             Boolean               @default(false)
  voidedAt           DateTime?
  items              PurchaseItem[]
  // Breakdown of how this purchase was actually paid, split across methods
  // and currencies — same model as Sale.payments (see SalePayment). Empty
  // for a PENDING (credit) purchase, and for any purchase created before
  // this feature existed.
  payments           PurchasePayment[]

  @@unique([branchId, controlNumber])
  @@index([companyId, createdAt])
  @@index([branchId, createdAt])
  @@index([supplierId])
}

// The inverse of SalePayment — one row per payment method used to settle a
// purchase (e.g. half cash Bs., half Zelle USD), instead of the single
// paymentStatus flag a Purchase had before this existed.
model PurchasePayment {
  id                    String        @id @default(cuid())
  purchaseId            String
  purchase              Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  paymentMethod         PaymentMethod
  amountEurCents        Int
  // The currency this line was actually paid in — "USD" for Zelle/Binance/
  // PayPal, or the company's own localCurrencyCode for Cash/Card/Other
  // (unless marked as foreign cash). amountEurCents is this converted to
  // the reference currency Purchase.totalCents uses; amountCurrencyCents is
  // the raw as-entered amount in currencyCode's own cents.
  currencyCode          String?
  amountCurrencyCents   Int?
  paidInForeignCurrency Boolean       @default(false)
  reference             String?
  // Snapshot of Company.exchangeRate on the day this line was recorded —
  // same reasoning as SalePayment.exchangeRate.
  exchangeRate          Decimal?      @db.Decimal(12, 4)
  createdAt             DateTime      @default(now())

  @@index([purchaseId])
}

model PurchaseItem {
  id             String      @id @default(cuid())
  purchaseId     String
  purchase       Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String
  taxCategory    TaxCategory @default(GENERAL)
  taxRatePercent Int         @default(16)
  unitCostCents  Int
  quantity       Int
  baseCents      Int
  taxCents       Int
  subtotalCents  Int
  // Off means this line still counts toward the libro de compras (base
  // imponible, IVA, totals) but never touches Product.stock/costCents —
  // for a purchase of something that isn't tracked inventory. On by default
  // so every purchase behaves exactly as before this field existed.
  affectsStock   Boolean     @default(true)

  @@index([purchaseId])
  @@index([productId])
}

// A recorded maintenance-fee payment, confirmed manually by a platform admin.
// Each payment extends Company.nextPaymentDueDate to `periodEnd`.
model Payment {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  amountUsdCents Int
  // Historical: platform Bs/USD rate in effect for this payment, back when
  // subscriptions could be paid in bolívares. Now that payment is exclusively
  // USDT via Binance, this is always null for anything recorded going
  // forward — kept nullable instead of dropped so old records stay intact.
  exchangeRate   Decimal? @db.Decimal(12, 4)
  periodEnd      DateTime
  note           String?
  verifiedById   String
  createdAt      DateTime @default(now())

  @@index([companyId, createdAt])
}

// A company user's self-reported claim of having paid the maintenance fee
// externally (per the platform's payment instructions). Stays PENDING until
// a super admin reviews it — approving one creates the matching Payment
// record and pushes out Company.nextPaymentDueDate; rejecting one leaves
// billing state untouched.
model PaymentReport {
  id                String              @id @default(cuid())
  companyId         String
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reportedById      String
  // Proof-of-payment image (base64 data URL), same storage pattern as
  // Company.logoDataUrl. Required by the submission form, kept nullable here
  // so a future schema change never needs a backfill.
  proofImageDataUrl String?             @db.Text
  note              String?
  // Who is reporting and how to reach them (the super admin can write them
  // on WhatsApp). Nullable: reports made before these fields existed.
  reporterName      String?
  reporterPhone     String?
  reporterEmail     String?
  status            PaymentReportStatus @default(PENDING)
  // One-time lifetime payment (lib/billing.ts LIFETIME_PRICE_USD_CENTS):
  // approving it exempts the company from monthly fees instead of extending
  // the due date.
  isLifetime        Boolean             @default(false)
  reviewedById      String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime            @default(now())
  lines             PaymentReportLine[]

  @@index([companyId, status])
  @@index([status, createdAt])
}

// One payment-method entry in a self-reported maintenance payment (e.g. part
// Zelle, part Pago Móvil) — mirrors SalePayment for the same reason.
model PaymentReportLine {
  id              String        @id @default(cuid())
  paymentReportId String
  paymentReport   PaymentReport @relation(fields: [paymentReportId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod
  amountUsdCents  Int
  reference       String?

  @@index([paymentReportId])
}

// A Binance Pay checkout created for a company's maintenance-fee cycle —
// unlike PaymentReport, this needs no manual admin review: the webhook at
// app/api/webhooks/binance-pay/route.ts marks it PAID and advances
// Company.nextPaymentDueDate automatically once Binance confirms funds
// actually arrived (see lib/binance-pay.ts for the signed request/webhook
// verification). merchantTradeNo is the idempotency key both directions —
// Binance echoes it back in the webhook payload, and a retried webhook for
// an already-PAID order is a no-op.
model BinancePayOrder {
  id              String                @id @default(cuid())
  companyId       String
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  merchantTradeNo String                @unique
  prepayId        String?
  amountUsdCents  Int
  status          BinancePayOrderStatus @default(PENDING)
  checkoutUrl     String?               @db.Text
  qrcodeLink      String?               @db.Text
  createdAt       DateTime              @default(now())
  paidAt          DateTime?

  @@index([companyId, status])
}

// An expected Pago Móvil (Banesco) payment for a company's maintenance-fee
// cycle — same idea as BinancePayOrder, but there's no merchant API to
// create/confirm a Pago Móvil transfer, so the "order" is really a
// reservation of a specific Bs amount the company is asked to transfer.
// expectedAmountBsCents gets a few random bolívar-cents added on top of the
// real fee (see createPagoMovilOrder in lib/actions/billing.ts) so a
// forwarded bank notification email can be matched back to exactly one
// pending order by amount alone — Pago Móvil references aren't something we
// can pre-assign the way merchantTradeNo works for Binance. See
// app/api/webhooks/banesco-email/route.ts for the other half: parsing the
// forwarded notification email and marking the matching order PAID.
model PagoMovilOrder {
  id                    String               @id @default(cuid())
  companyId             String
  company               Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  amountUsdCents        Int
  // Platform Bs/USD rate used to compute expectedAmountBsCents — snapshotted
  // here so the Payment record created on confirmation uses the exact rate
  // that was quoted, even if the platform rate changes before the transfer
  // actually arrives.
  exchangeRate          Decimal              @db.Decimal(12, 4)
  expectedAmountBsCents Int
  status                PagoMovilOrderStatus @default(PENDING)
  // Pending orders older than this stop being eligible to match an incoming
  // email — without an expiry, a stale unpaid reservation could collide
  // with a brand-new one asking for the same bumped amount.
  expiresAt             DateTime
  createdAt             DateTime             @default(now())
  paidAt                DateTime?

  @@index([companyId, status])
  @@index([expectedAmountBsCents, status])
}

// A manually logged business expense (Finanzas), used together with revenue
// and Product.costCents to estimate net profit for a date range.
model Expense {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  description      String
  category         String?
  // Sede a la que se cargó el gasto (la activa al registrarlo); null = general / anterior.
  branchId         String?
  // Always the reference-currency amount (EUR/USD) — every Finanzas total
  // sums this column, so an expense entered in local currency is converted
  // at the rate of the moment it was recorded.
  amountCents      Int
  // True when the owner typed the amount in the local currency (Bs.).
  enteredInLocal   Boolean  @default(false)
  // Local-currency amount in cents: what was typed when enteredInLocal, or
  // the equivalent at `exchangeRate` otherwise. Null on expenses recorded
  // before this existed (or when the company has no exchange rate enabled).
  localAmountCents Int?
  // Snapshot of Company.exchangeRate (local per reference unit) at entry.
  exchangeRate     Decimal? @db.Decimal(12, 4)
  spentAt          DateTime @default(now())
  createdById      String?
  createdBy        User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@index([companyId, spentAt])
  @@index([companyId, branchId])
}

// A formal end-of-day cash register closing — freezes that business day's
// totals (see lib/actions/cash-closing.ts, computed the same way the Reportes
// breakdown is) and blocks voiding/deleting any sale from that day
// afterward (see voidSale/deleteSale in lib/actions/sales.ts), the same way
// a real end-of-day reconciliation would. closingDate is a calendar day in
// the shop's timezone (America/Caracas, see SHOP_TIME_ZONE), not a instant.
model CashClosing {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  closingDate DateTime @db.Date
  totalCents  Int
  salesCount  Int
  note        String?
  // Conteo físico al cerrar: total contado en $ y en Bs, efectivo esperado y diferencia
  // (en centavos de la divisa de referencia). Nulos en cierres anteriores.
  countedUsdCents  Int?
  countedBsCents   Int?
  expectedCashCents Int?
  differenceCents  Int?
  closedById  String
  closedAt    DateTime @default(now())

  @@unique([branchId, closingDate])
  @@index([companyId, closingDate])
}

// Single global row of platform-wide config, managed by the super admin —
// currently just the default payment instructions shown to every company
// (e.g. Pago Móvil/transfer details). Not scoped by company, so it's
// deliberately outside Row-Level Security, like User/Company.
model PlatformSettings {
  id                            String    @id
  // Extra free-text notes shown under the Binance details below (e.g. "solo
  // horario laboral", "confirma por WhatsApp antes de enviar") — the QR/ID
  // pair are the actual payment instructions now, this is just supplementary.
  paymentInstructions           String?   @db.Text
  // Binance Pay QR code, shown on /billing so a company can scan it to pay
  // the subscription — same base64 data-URL pattern as Company.logoDataUrl,
  // uploaded via PlatformSettingsForm (resizeImageToDataUrl).
  binanceQrDataUrl              String?   @db.Text
  // Binance Pay ID / UID, shown alongside the QR as a manual fallback for
  // whoever can't scan it.
  binanceId                     String?
  // Pago Móvil details for paying the subscription in Bolívares — the
  // second rail alongside Binance/USDT above. Same manual-report-then-
  // super-admin-approves flow as Binance; there's no bank webhook wired up,
  // this is just where to send it (see /billing and PaymentReportForm's
  // BILLING_PAYMENT_METHODS, which accepts "CARD" — this app's enum name
  // for Pago Móvil, see PAYMENT_METHOD_LABELS).
  pagoMovilBank                 String?
  pagoMovilPhone                String?
  // Cédula or RIF the Pago Móvil account is registered under.
  pagoMovilId                   String?
  // Applied to Company.monthlyFeeUsdCents automatically when a super admin
  // approves a new signup and leaves the fee field blank (see approveUser
  // in lib/actions/admin.ts) — a single platform-wide price for every new
  // company, editable here without touching already-onboarded companies'
  // own (possibly custom) monthlyFeeUsdCents.
  defaultMonthlyFeeUsdCents     Int?
  // Bolívares per 1 USD, used only to show the subscription's Bs-equivalent
  // price for Pago Móvil (see getPlatformExchangeRateInfo, lib/actions/
  // billing.ts) — the subscription itself is always billed in USD/USDT, so
  // this is deliberately independent of any one company's own Company.
  // exchangeRate (which might be EUR-denominated, disabled, or just wrong
  // for this purpose). Self-heals the same way a company's own rate does:
  // refreshed once a day by the cron at app/api/cron/bcv-rate/route.ts, plus
  // a stale check on read — a super admin can also type one in directly or
  // force a BCV refresh from /admin, same UX as a company's own rate in
  // Settings.
  platformExchangeRate          Decimal?  @db.Decimal(12, 4)
  platformExchangeRateUpdatedAt DateTime?
  updatedAt                     DateTime  @updatedAt
}

// Nota de crédito (audit KRPOS-FIS-003): the fiscal way to cancel an issued
// factura. Always for the whole sale — issuing one voids the sale and puts
// its stock back. Numbered per branch with its own monotonic counter
// (Branch.nextCreditNoteNumber), never count() + 1.
model CreditNote {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branchId           String
  branch             Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  saleId             String   @unique
  sale               Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  controlNumber      Int
  reason             String
  totalCents         Int
  baseImponibleCents Int
  taxCents           Int
  igtfCents          Int      @default(0)
  createdById        String?
  createdByName      String?
  createdAt          DateTime @default(now())

  @@unique([branchId, controlNumber])
  @@index([companyId, createdAt])
}

// Nota de débito: an extra charge on an already-issued factura (a cost the
// invoice missed, a price correction upward). Amount is tax-inclusive and
// decomposed with the company's general IVA rate. Own per-branch counter
// (Branch.nextDebitNoteNumber).
model DebitNote {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branchId           String
  branch             Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  saleId             String
  sale               Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  controlNumber      Int
  reason             String
  totalCents         Int
  baseImponibleCents Int
  taxCents           Int
  createdById        String?
  createdByName      String?
  createdAt          DateTime @default(now())

  @@unique([branchId, controlNumber])
  @@index([companyId, createdAt])
  @@index([saleId])
}

// Efectivo con el que arranca la caja de una sucursal en un día (Caja Chica).
// Montos en la divisa referencial, como el resto de la contabilidad.
model CashOpening {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  date        DateTime @db.Date
  amountCents Int
  // Saldo inicial por método de efectivo (Bs en céntimos de bolívar; $ en céntimos de la referencia).
  openingBsCents  Int?
  openingUsdCents Int?
  setById     String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([branchId, date])
  @@index([companyId, date])
}

// Salida de efectivo de la Caja Chica (pago de un gasto menor, retiro, etc.).
model CashOutflow {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  date        DateTime @db.Date
  concept     String
  amountCents Int
  createdById String
  createdAt   DateTime @default(now())

  @@index([companyId, branchId, date])
}

// Persona a la que la empresa le paga nómina (no tiene que usar el sistema).
// Montos en la divisa referencial.
model PayrollEmployee {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  nationalId     String?
  position       String?
  baseCents      Int
  foodBonusCents Int              @default(0)
  // Comisión sobre lo que esta persona vendió en la quincena (% de sus ventas).
  // `userId` es el usuario del sistema que firma sus ventas (opcional).
  commissionPct  Float            @default(0)
  userId         String?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  payments       PayrollPayment[]

  @@index([companyId, active])
}

// Pago de una quincena a un empleado. `period` es "AAAA-MM-1" o "AAAA-MM-2".
// Al registrarse crea también un Expense (categoría Nómina) para Finanzas.
model PayrollPayment {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        PayrollEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  period          String
  grossCents      Int
  deductionsCents Int
  advanceCents    Int             @default(0)
  commissionCents Int             @default(0)
  netCents        Int
  paymentMethod   PaymentMethod
  reference       String?
  proofDataUrl    String?         @db.Text
  expenseId       String?
  paidById        String
  paidAt          DateTime        @default(now())

  @@unique([employeeId, period])
  @@index([companyId, period])
}

enum PaymentAccountKind {
  PAGO_MOVIL
  TRANSFER
  ZELLE
  BINANCE
  PAYPAL
}

// Datos que el cliente necesita para pagarle a la empresa (varios pagos móviles,
// cuentas, Zelle, etc.). Se muestran en el POS con el logo del banco.
model PaymentAccount {
  id            String             @id @default(cuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind          PaymentAccountKind
  // Clave del logo (ver lib/payment-accounts.ts) y nombre del banco o servicio.
  bankKey       String?
  bankName      String?
  holder        String?
  // Teléfono (pago móvil), número de cuenta, correo (Zelle/PayPal) o ID (Binance).
  accountNumber String
  // Cédula o RIF del titular.
  docId         String?
  note          String?
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  // Saldo: inicial + cobros del método vinculado desde balanceSince.
  currency      String             @default("USD")
  openingCents  Int                @default(0)
  linkedMethod  PaymentMethod?
  balanceSince  DateTime           @default(now())

  @@index([companyId, active])
}

// Traspaso de mercancía entre dos sucursales de la misma empresa: saca stock de
// una y lo suma en la otra, y queda en el historial de movimientos de cada producto.
model BranchTransfer {
  id            String               @id @default(cuid())
  companyId     String
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromBranchId  String
  fromBranch    Branch               @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranchId    String
  toBranch      Branch               @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: Restrict)
  note          String?
  createdById   String
  createdByName String
  createdAt     DateTime             @default(now())
  items         BranchTransferItem[]

  @@index([companyId, createdAt])
}

model BranchTransferItem {
  id          String         @id @default(cuid())
  transferId  String
  transfer    BranchTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productName String
  sku         String?
  quantity    Int

  @@index([transferId])
}

// Video de la sección Learning. Es contenido de la plataforma (igual para todas
// las empresas), por eso no lleva companyId ni RLS, como PlatformSettings. Solo
// el administrador de la plataforma los agrega; máximo 10.
model LearningVideo {
  id          String   @id @default(cuid())
  title       String
  description String?
  // O un enlace (YouTube/Vimeo) o un archivo MP4 en R2 (r2Key); uno de los dos.
  url         String?
  r2Key       String?
  position    Int
  // Ruta sugerida (Todo, Dueño, Cajero, Vendedor, Contador), estado y puntos de «lo que aprendes».
  audience    String   @default("Todo")
  published   Boolean  @default(true)
  learns      String[] @default([])
  createdAt   DateTime @default(now())

  @@index([position])
}

// Qué videos ya vio cada usuario (avance de Learning). Es por usuario, no por empresa.
model LearningProgress {
  userId    String
  videoId   String
  watchedAt DateTime @default(now())

  @@id([userId, videoId])
  @@index([videoId])
}

// Historial del Asistente IA: cada pregunta con su respuesta y, si el asistente
// propuso un cambio, si el usuario lo aplicó. Es de cada usuario (userId).
model AssistantEntry {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  question  String
  answer    String
  proposal  Json?
  applied   Boolean  @default(false)
  // Deshacer 24 h sin costo: qué hacer para revertir y si ya se revirtió.
  appliedAt DateTime?
  undoData  Json?
  undone    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([companyId, userId, createdAt])
}

// Solicitud de compra de créditos del Asistente IA. La empresa paga por los
// medios de siempre y manda la referencia; el administrador de KR System la
// aprueba (suma los créditos) o la rechaza.
model AiCreditRequest {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedBy String
  credits     Int
  priceCents  Int
  reference   String
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([companyId, createdAt])
  @@index([status, createdAt])
}

// Promoción de Marketing: descuento con código y vigencia dirigido a un grupo de clientes.
model Promotion {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  code            String
  discountPercent Int
  segment         String
  validUntil      DateTime
  // Segmentación: segment = todos | campeones | leales | riesgo | dormidos | cumpleaneros | clientes.
  // cumpleaneros usa rangeFrom/rangeTo (AAAA-MM-DD; solo cuentan día y mes); clientes usa customerIds.
  rangeFrom       String?
  rangeTo         String?
  customerIds     String[] @default([])
  createdAt       DateTime @default(now())
  redemptions     PromotionRedemption[]

  @@unique([companyId, code])
  @@index([companyId, validUntil])
}

model PromotionRedemption {
  id          String    @id @default(cuid())
  companyId   String
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  customerId  String?
  saleId      String?
  note        String?
  createdAt   DateTime  @default(now())

  // Un cliente no puede canjear el mismo cupón dos veces (los canjes manuales sin cliente no cuentan).
  @@unique([promotionId, customerId])
  @@index([promotionId])
  @@index([companyId])
}
