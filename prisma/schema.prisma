generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

model Company {
  id                    String    @id @default(cuid())
  name                  String
  // Bolívares (VES) per 1 EUR. Set by the shop owner and updated daily.
  exchangeRate          Decimal?  @db.Decimal(12, 4)
  exchangeRateUpdatedAt DateTime?
  // Small logo image as a base64 data URL, and a hex brand accent color.
  logoDataUrl           String?   @db.Text
  brandColor            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  users                 User[]
  products              Product[]
  sales                 Sale[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
}

model Product {
  id                String     @id @default(cuid())
  name              String
  sku               String?
  category          String?
  priceCents        Int
  costCents         Int?
  stock             Int        @default(0)
  lowStockThreshold Int        @default(5)
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  companyId         String
  company           Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  saleItems         SaleItem[]

  @@unique([companyId, sku])
  @@index([companyId, isActive])
  @@index([companyId, category])
}

model Sale {
  id                    String        @id @default(cuid())
  createdAt             DateTime      @default(now())
  totalCents            Int
  paymentMethod         PaymentMethod @default(CASH)
  note                  String?
  // Snapshot of Company.exchangeRate (VES per EUR) at the moment this sale was
  // completed, so historical receipts/reports never change if the rate is
  // updated later. Null for sales completed before this feature existed.
  exchangeRate          Decimal?      @db.Decimal(12, 4)
  // Whether the customer paid in physical foreign currency (USD/EUR) rather
  // than bolívares, regardless of paymentMethod.
  paidInForeignCurrency Boolean       @default(false)
  customerFirstName     String?
  customerLastName      String?
  customerPhone         String?
  customerAddress       String?
  companyId             String
  company               Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items                 SaleItem[]

  @@index([companyId, createdAt])
}

model SaleItem {
  id             String   @id @default(cuid())
  saleId         String
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String
  unitPriceCents Int
  quantity       Int
  subtotalCents  Int

  @@index([saleId])
  @@index([productId])
}
