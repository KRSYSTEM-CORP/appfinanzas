# Copia a /opt/kr/app.env (permisos 600). NUNCA subir el archivo real a GitHub.
NODE_ENV=production
# Base de datos: rol app_runtime (sin BYPASSRLS) por la red privada.
DATABASE_URL=postgresql://app_runtime:CAMBIAR@10.0.0.3:5432/kr_pos
# Migraciones: dueño de la base (solo lo usa el servicio migrate).
DIRECT_URL=postgresql://kr_owner:CAMBIAR@10.0.0.3:5432/kr_pos
AUTH_SECRET=CAMBIAR
CRON_SECRET=CAMBIAR
RESEND_API_KEY=
BANESCO_EMAIL_WEBHOOK_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Asistente IA (opcional)
ANTHROPIC_API_KEY=
# Videos de Learning en R2 (opcional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_LEARNING_BUCKET=kr-learning
